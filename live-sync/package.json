{
  "name": "gql-fiddle-live-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "preinstall": "node -e \"if (!/^npm\\//.test(process.env.npm_config_user_agent||'')) { console.error('ERROR: live-sync is an npm-only project — do not run pnpm/yarn here. Use: npm --prefix live-sync install'); process.exit(1); }\"",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true
  }
}
