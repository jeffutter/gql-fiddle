{
  // Cloudflare Pages project configuration.
  // See https://developers.cloudflare.com/pages/functions/wrangler-configuration/
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "gql-fiddle",
  "pages_build_output_dir": "web/dist",
  "compatibility_date": "2026-06-01",

  "vars": {
    "ENVIRONMENT": "production",
    // Public origin used to build the GitHub OAuth redirect_uri (TASK-100) —
    // must never be derived from the request Host header, since that's
    // attacker-influenceable. Placeholder: replace with the real production
    // custom domain (or *.pages.dev subdomain) once known, and register the
    // matching callback URL (`${APP_ORIGIN}/api/auth/github/callback`) in the
    // GitHub OAuth App settings.
    "APP_ORIGIN": "https://gqlfiddle.dev",
    // Origin of the live-sync Worker (TASK-119.1). Used by the Pages Function
    // at /api/live-session to build the WebSocket URL returned to clients.
    // For local dev, set to http://localhost:8789 in .dev.vars.
    "LIVE_SYNC_URL": "https://live-sync.gqlfiddle.dev"
  },

  // D1 SQLite database for workspace persistence (TASK-88.2 adds the schema).
  //
  // To provision:
  //   wrangler d1 create gql-fiddle-db
  // Replace database_id with the ID printed by that command.
  // For production, configure the binding in the Pages project settings
  // (dashboard or wrangler) using the real database_id.
  // Local dev always uses a local SQLite file (.wrangler/state/v3/d1/).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gql-fiddle-db",
      "database_id": "b52a7c08-99dd-41b0-9c5f-0baf5e796362",
      "migrations_dir": "migrations"
    }
  ],

  // KV namespace for session tokens (TASK-88.3 adds the auth logic).
  //
  // To provision:
  //   wrangler kv namespace create SESSIONS
  // Replace id with the namespace_id printed by that command.
  // For production, configure the binding in the Pages project settings.
  // Local dev always uses in-memory storage.
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "6ed8414d3a5a4827b7432492fe4db840"
    }
  ],

  // TODO: UserSyncDO (TASK-88.8) needs to move to a standalone Worker with a
  // Service Binding back to this Pages project.  Cloudflare Pages does not
  // support co-locating Durable Object classes within a Pages project — the DO
  // class must be the export of a separate Worker deployment.
}
