{
  "name": "gql-fiddle-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "bash ../scripts/patch-workerd-nixos.sh",
    "build:wasm": "wasm-pack build ../crates/gql-core --target web --out-dir ../../web/src/wasm",
    "db:migrate": "wrangler d1 migrations apply gql-fiddle-db --local --config ../wrangler.jsonc",
    "dev": "pnpm build:wasm && concurrently --kill-others-on-fail \"cargo watch --watch $(pwd)/../crates/gql-core/src -s 'pnpm --dir $(pwd) build:wasm'\" \"vite\"",
    "dev:full": "pnpm db:migrate && pnpm build:wasm && concurrently --kill-others-on-fail --names wasm,vite,wrangler,live-sync \"cargo watch --watch $(pwd)/../crates/gql-core/src -s 'pnpm --dir $(pwd) build:wasm'\" \"vite\" \"cd $(pwd)/.. && wrangler pages dev web/dist\" \"cd $(pwd)/../live-sync && npm run dev\"",
    "dev:no-wasm": "vite",
    "pages:dev": "pnpm db:migrate && cd .. && wrangler pages dev web/dist",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "test:functions": "vitest run --config vitest.functions.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.11.1",
    "graphql": "^17.0.2",
    "js-yaml": "^5.2.1",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "monaco-graphql": "^1.8.0",
    "monaco-vim": "^0.4.4",
    "pako": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.21",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
