# Local-only secrets for wrangler pages dev.
# Copy this file to .dev.vars (gitignored) and fill in your values.
#
# To apply: wrangler pages dev web/dist reads .dev.vars automatically.

# "development" enables the /api/auth/dev-login bypass. This must be set
# explicitly — the gate is fail-closed, so an unset (or any other) value
# 404s the dev-login endpoint and routes /api/auth/login to GitHub OAuth.
# Set to "production" (or remove this line) to test real GitHub OAuth locally
# (requires a registered OAuth App with
# http://localhost:8788/api/auth/github/callback as callback URL).
ENVIRONMENT=development

# Public origin used to build the GitHub OAuth redirect_uri (TASK-100) — the
# server never trusts the request's Host header for this. Must match whatever
# host is registered as the GitHub OAuth App's callback: http://localhost:8788
# for local dev (wrangler pages dev's default port).
APP_ORIGIN=http://localhost:8788

# Synthetic user identity for /api/auth/dev-login.
# Change to "dev-user-2" (and run a second wrangler dev on a different port)
# to simulate two different users for cross-device sync testing.
DEV_USER_ID=dev-user-1

# Required only when ENVIRONMENT=production or for real OAuth testing:
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
